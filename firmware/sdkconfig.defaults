# Cardputer (original + ADV), M5Stamp-S3: ESP32-S3FN8 — 8 MB flash
# (QIO/80MHz), 512 KB SRAM, no PSRAM.
#
# QIO matters: weights stream from MMU-mapped flash on every token, so flash
# read bandwidth is the throughput ceiling for the 8M model. The in-package
# flash supports quad I/O (stock M5 firmware ships QIO).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# 64-byte dcache lines refill flash reads more efficiently (sequential
# streaming workload); cache size stays 32 KB — SRAM is the scarce resource.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Single ~7.9 MB factory app slot — code + embedded Q4 model in one image.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Inference hot loops want -O2 (flash space is not the constraint here).
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# app_main runs the UI loop (std::string, vsnprintf, M5GFX, search).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# 1 ms tick so the idle keyboard poll (vTaskDelay(1)) stays responsive.
CONFIG_FREERTOS_HZ=1000

# Generation occupies both cores (main task + pinned matmul worker), so the
# idle tasks can starve for the length of a reply. Don't let the task WDT
# panic on that — same behaviour the Arduino core build had.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# FAT long file names (categories.txt, <category>.md) on the SD card.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

# WiFi is only up for an NTP sync; keep its buffers small (RAM goes to the model).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# Logs on the USB port the Cardputer is flashed through.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# TinyDecide (components/tinydecide, from huggingface.co/TheREZOR/TinyDecide esp32/): embed
# ../model/model.bin in the app image.
CONFIG_TINYDECIDE_EMBED_MODEL=y
CONFIG_TINYDECIDE_MODEL_DIR="../model"
